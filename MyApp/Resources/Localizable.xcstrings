            "state": "translated",
            "value": "Wähle Videos aus, um zu sehen, wie stark sie schrumpfen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar küçüleceklerini görmek için video seç."
          }
