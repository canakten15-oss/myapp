    "Slash could free": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash könnte freigeben"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash boşaltabilir"
          }
        }
      }
    },
    "Slash could free about %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash könnte etwa %@ freigeben"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash yaklaşık %@ boşaltabilir"
          }
        }
      }
    },
    "Slash is compressing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash komprimiert"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash sıkıştırıyor"
          }
        }
      }
    },
    "Slash makes smaller copies of your biggest videos on this iPhone. Nothing is uploaded, and nothing is deleted without your confirmation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash erstellt auf diesem iPhone kleinere Kopien deiner größten Videos. Nichts wird hochgeladen, und nichts wird ohne deine Bestätigung gelöscht."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash, bu iPhone'da en büyük videolarının daha küçük kopyalarını oluşturur. Hiçbir şey yüklenmez ve onayın olmadan hiçbir şey silinmez."
          }
        }
      }
    },
    "Slash makes smaller copies of your biggest videos, often half the size or less, with no visible difference on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash erstellt kleinere Kopien deiner größten Videos, oft halb so groß oder kleiner, ohne sichtbaren Unterschied auf deinem iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash, en büyük videolarının daha küçük kopyalarını oluşturur; çoğu zaman yarı boyutta veya daha küçük, iPhone'unda görünür bir fark olmadan."
          }
        }
      }
    },
    "Slash the size. Keep the shot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe runter. Bild bleibt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutu kes. Görüntüyü koru."
          }
        }
      }
    },
    "Smallest files. No visible difference on the phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinste Dateien. Kein sichtbarer Unterschied auf dem Handy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En küçük dosyalar. Telefonda görünür bir fark yok."
          }
        }
      }
    },
    "Source code (open source)": {
      "localizations": {
        "de": {
