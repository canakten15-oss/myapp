            "value": "Video %lld / %lld · %@"
          }
        }
      }
    },
    "Watch the copies first. They're in your library with the same date, place and albums.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir zuerst die Kopien an. Sie sind in deiner Mediathek, mit demselben Datum, Ort und denselben Alben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce kopyaları izle. Aynı tarih, konum ve albümlerle arşivinde duruyorlar."
          }
        }
      }
    },
    "You can leave Slash. It keeps working and shows its progress on the Lock Screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Slash verlassen. Es arbeitet weiter und zeigt den Fortschritt auf dem Sperrbildschirm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slash'tan çıkabilirsin. Çalışmaya devam eder ve ilerlemeyi kilit ekranında gösterir."
          }
        }
      }
    },
    "You decide": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karar senin"
          }
        }
      }
    },
    "Your videos": {
