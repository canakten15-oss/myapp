          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göster"
          }
        }
      }
    },
    "Shrunk videos show up here, so you can compare them with the original.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleinerte Videos erscheinen hier, damit du sie mit dem Original vergleichen kannst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçültülen videolar burada görünür, böylece onları orijinalle karşılaştırabilirsin."
          }
        }
      }
    },
    "Shrunk · %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleinert · %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçültüldü · %lld"
          }
        }
      }
    },
    "Size, savings, quality score and time for each video. No video content or location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe, Ersparnis, Qualitätswert und Zeit pro Video. Keine Videoinhalte und kein Ort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her video için boyut, tasarruf, kalite puanı ve süre. Video içeriği veya konum yok."
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atla"
          }
        }
      }
    },
    "Slash %lld videos": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Slash %lld video"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Slash %lld videos"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Video verkleinern"
                }
              },
              "other": {
