          }
        }
      }
    },
    "Test report": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testbericht"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test raporu"
          }
        }
      }
    },
    "The original is already deleted. You're watching the copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original ist bereits gelöscht. Du siehst die Kopie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal zaten silindi. Kopyayı izliyorsun."
          }
        }
      }
    },
    "These would lose visible quality, so the originals were kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese würden sichtbar Qualität verlieren, deshalb wurden die Originale behalten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar görünür kalite kaybederdi, bu yüzden orijinaller korundu."
          }
        }
      }
    },
    "These would lose visible quality, so the originals were kept. Swipe to try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese würden sichtbar Qualität verlieren, deshalb wurden die Originale behalten. Wische, um es erneut zu versuchen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar görünür kalite kaybederdi, bu yüzden orijinaller korundu. Tekrar denemek için kaydır."
          }
        }
      }
    },
