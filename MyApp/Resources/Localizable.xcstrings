    "iOS asks you to confirm. Deleted videos stay in “Recently Deleted” for 30 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt nach einer Bestätigung. Gelöschte Videos bleiben 30 Tage in „Zuletzt gelöscht“."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS onay ister. Silinen videolar 30 gün boyunca “Son Silinenler”de kalır."
          }
        }
      }
